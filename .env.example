# Copy to .env  (cp .env.example .env).  Never commit .env.
# ---- Model selection ------------------------------------------------------
LLM_PROVIDER=ollama              # ollama (local, default) | anthropic (cloud)
LLM_FALLBACK_PROVIDER=           # optional: used automatically if the primary is unavailable
LLM_TIMEOUT_SECONDS=180
LLM_IDLE_TIMEOUT_SECONDS=90
# ---- Local: Ollama (on your host: `ollama serve`, `ollama pull qwen3:8b`) --
# Tip: run Ollama with OLLAMA_CONTEXT_LENGTH=16384 so retrieved sources aren't truncated.
OLLAMA_BASE_URL=http://host.docker.internal:11434   # use http://localhost:11434 when running without Docker
OLLAMA_MODEL=qwen3:8b
# ---- Cloud: Anthropic (optional) ------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=            # any Anthropic-compatible gateway
# ---- Knowledge base ---------------------------------------------------------
AUTO_INGEST=true                 # download + index transcripts on first start
# ---- Ops ----------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
# ADMIN_TOKEN=change-me          # enables POST /api/admin/reingest
